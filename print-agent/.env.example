# Direccion del sistema. En produccion, el dominio con https.
SERVIDOR=https://tulocal.comandasupreg.com

# La clave del agente: se genera en el panel, en Configuración → Impresión
PRINT_TOKEN=cambiar-por-un-token-largo-y-aleatorio

# El local de esta PC, como aparece en la web: pedidos.tupizzeria.com/adrogue -> adrogue
# Obligatorio si hay mas de una sucursal: si no, se imprimirian las comandas del otro local.
SUCURSAL=adrogue

# red     -> impresora con IP propia (lo mas confiable)
# usb     -> impresora instalada en el sistema operativo
# archivo -> modo prueba, muestra la comanda en pantalla
MODO=red

# Solo si MODO=red
IMPRESORA_IP=192.168.1.100
IMPRESORA_PUERTO=9100

# Solo si MODO=usb. El nombre exacto que figura en el sistema.
IMPRESORA_NOMBRE=POS-80

# Cada cuanto consulta la cola, en milisegundos
INTERVALO_MS=2000

# Vacio imprime todo. Si tenes una impresora en cocina y otra en caja,
# instala dos agentes y poné cocina en uno y caja en el otro.
ESTACIONES=

# Abrir el cajon de dinero al imprimir el ticket de caja
ABRIR_CAJON=false
