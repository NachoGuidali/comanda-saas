# ─────────── Base de datos ───────────
# En desarrollo local (sin Docker), apuntá a tu Postgres:
DATABASE_URL="postgresql://pizzeria:pizzeria@localhost:5432/pizzeria"

# En produccion con Docker Compose, la arma el compose sola.
# Solo tenés que poner una contraseña fuerte acá:
DB_PASSWORD=

# ─────────── Seguridad ───────────
# Firma las sesiones. Generalo con: openssl rand -base64 48
# Obligatorio: sin él, el sistema no arranca en producción.
AUTH_SECRET=

# Las impresoras se agregan desde el panel de cada local (Configuración →
# Impresión) y se vinculan con un código. Esto es solo para agentes viejos
# configurados a mano con .env. En el SaaS, vacío.
PRINT_TOKEN=

# ─────────── Dominio de la plataforma ───────────
# Sin https://. En el DNS van DOS registros A a la IP del servidor:
#   comandasupreg.com     y     *.comandasupreg.com
# Cada cliente entra por su subdominio: pepperino.comandasupreg.com
# En la PC local: SAAS_DOMINIO=localhost y se entra por pepperino.localhost:3000
SAAS_DOMINIO=comandasupreg.com

# Opcional: el cliente que se muestra si se entra por la IP o por un dominio
# que no es de nadie. Útil para una instalación de un solo local. En el SaaS, vacío.
# TENANT_POR_DEFECTO=pepperino

# ─────────── Zona horaria ───────────
# La hora del local. Horarios, promos por día, reportes y comandas dependen de esto.
TZ=America/Argentina/Buenos_Aires

# ─────────── Mercado Pago ───────────
# El pago online de cada LOCAL usa la cuenta de ese local: el dueño la conecta
# en su panel (Configuración → Cobro online). No va acá.
#
# Acá va la cuenta de la PLATAFORMA, para cobrar los abonos a los clientes
# (links de pago y débito automático). Access Token de producción:
# PLATAFORMA_MP_TOKEN=APP_USR-...
# Webhook en Mercado Pago: https://SAAS_DOMINIO/api/plataforma/mp/webhook
# (eventos Pagos y Planes y suscripciones). Su clave secreta:
# PLATAFORMA_MP_WEBHOOK_SECRET=

# ─────────── Abonos ───────────
# Días antes del vencimiento en que se avisa, días de gracia antes de
# suspender, y si se suspende solo (false = solo avisos).
SAAS_DIAS_AVISO=5
SAAS_DIAS_GRACIA=5
SAAS_SUSPENDER_VENCIDOS=true

# Administrador de la plataforma (comandasupreg.com/plataforma). deploy.sh lo
# crea o le actualiza la clave. Clave de al menos 10 caracteres.
PLATAFORMA_EMAIL=
PLATAFORMA_PASSWORD=

# Opcional: clave para cifrar las credenciales guardadas en la base (los
# Access Token de Mercado Pago de los locales). Si no está, se deriva de
# AUTH_SECRET. Si la cambiás, hay que volver a cargar esas credenciales.
# CIFRADO_CLAVE=
